@model PeliculasWeb.Models.Categoria //ponemos para que sepa sobre que modelo va a trabajar
@{
    ViewData["Title"] = "Crear Nueva Categoria";
}

<!--codigo HTML-->

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-8">
            <h2 class="text-primary">
                Crear Nueva Categoria
            </h2>
        </div>
        <div class="col-4 text-end">
            <a asp-action="Create" class="btn btn-success text-white">
                <i class="fas fa-plus"></i>Crear Nueva Categoria
            </a>
        </div>
    </div>

    <!--para crear el formulario -->
    <div class="row">
        <div class="col-sm-12">
            <form method="post" asp-action="Create">
                <!--si yo en el modelo puse required algun campo esta linea de codigo valida que se cumpla con eso-->
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group row mb-3">
                    <label asp-for="Nombre" class="col-4 col-form-label"></label>
                    <div class="col-8">
                        <input asp-for="Nombre" class="form-control" placeholder="Ingrese el nombre de Categoria" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col">
                        <button type="submit" class="btn btn-primary form-control">Crear Categoría</button>
                    </div>

                    <!--boton para ir atras-->
                    <div class="col-6">
                        <a asp-action="Index" class="btn btn-secondary w-100 ">
                            <i class="fas fa-arrow-left">Volver</i>
                        </a>
                    </div>
                </div>

            </form>
        </div>
    </div>


</div>
