@{
    //titulo de la pestaña del navegador
    ViewData["Title"] = "Lista de Peliculas";
}

<!--codigo HTML-->

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-8">
            <h2 class="text-primary">
                <i class="fas fa-list-alt"></i>Lista de Peliculas
            </h2>
        </div>
        <div class="col-4 text-end">
            <a asp-action="Create" class="btn btn-success text-white">
                <i class="fas fa-plus"></i>Crear Nueva Peliculas
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table id="tblPeliculas" class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">Descripcion</th>
                    <th scope="col">Clasificacion</th>
                    <th scope="col">Duracion</th>
                    <th scope="col">Fecha Creación</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <!--aca van las filas generadas por DATATABLE Se va a llenar utilizando el plugin data.table de js -->
            </tbody>
        </table>
    </div>
</div>

<!--importar script-->
<!--cual va a ser el archivo que va utilizar data-table para traer los datos de la api y mostrarlos -->
@section Scripts {
    <script src="~/js/pelicula.js"></script>
}
